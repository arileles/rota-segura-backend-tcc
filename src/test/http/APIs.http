# @name listOccurrences
GET http://localhost:8081/v1/occurrence
Content-Type: application/json
Authorization: Bearer {{authToken}}

@occurrenceId = {{listOccurrences.response.body.$[0].id}}

###

@arquivo = ./imagem1.png
# @arquivo = ./imagem2.png

# @name uploadMedia
POST http://localhost:8081/v1/media/upload
Content-Type: multipart/form-data; boundary=----WebKitFormBoundary7MA4YWxkTrZu0gW
Authorization: Bearer {{authToken}}

------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="file"; filename="example.jpg"
Content-Type: image/png

< {{arquivo}}
------WebKitFormBoundary7MA4YWxkTrZu0gW
Content-Disposition: form-data; name="occurrenceId"

{{occurrenceId}}
------WebKitFormBoundary7MA4YWxkTrZu0gW--

@mediaId = {{uploadMedia.response.body.id}}

###


# @name listOccurenceMedia
GET http://localhost:8081/v1/media?occurrenceId={{occurrenceId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}

# @mediaId = {{listOccurenceMedia.response.body.$[0].id}}
@mediaId = {{listOccurenceMedia.response.body.$[1].id}}

###

GET http://localhost:8081/v1/media/{{mediaId}}/image
Content-Type: application/json
Authorization: Bearer {{authToken}}

###

GET http://localhost:8081/v1/geo/address?q=Rua Bahia, 300, Blumenau, SC
Authorization: Bearer {{authToken}}

###

GET http://localhost:8081/v1/keys/maps
Authorization: Bearer {{authToken}}

###

GET http://localhost:8081/v1/genai/occurrence?id={{occurrenceId}}
Accept: application/json
Authorization: Bearer {{authToken}}

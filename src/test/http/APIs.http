# @name login
POST http://localhost:8081/v1/auth/login
Content-Type: application/json

{
  "email": "admin@rotasegura.com.br",
  "password": "pronto"
}

@authToken = {{login.response.body.token}}

###

GET http://localhost:8081/v1/promotion
Content-Type: application/json
Authorization: Bearer {{authToken}}

###

# @name listUsers

GET http://localhost:8081/v1/users
Content-Type: application/json
Authorization: Bearer {{authToken}}

@userId = {{listUsers.response.body.content[0].id}}

###

# @name users
POST http://localhost:8081/v1/users
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "name": "User Teste",
  "password": "teste123",
  "email": "a@b.com"
}

@userId = {{users.response.body.id}}

###

# @name postOccurrence1
POST http://localhost:8081/v1/occurrence
Content-Type: application/json
Authorization: Bearer {{authToken}}

{
  "type": "TEMPESTADE",
  "severity": "MEDIO",
  "status": "REPORTED",
  "description": "Descrição da ocorrência de teste",
  "reportedAt": "2024-06-15T10:00:00",
  "validated": false,
  "latitude": -26.916069, 
  "longitude": -49.072194,
  "address": "R. 7 de Setembro - Centro, Blumenau - SC, 89012-400",
  "reporterUser": "{{userId}}"
}

@occurrenceId = {{postOccurrence1.response.body.id}}

